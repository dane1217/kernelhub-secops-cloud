# Reference only. scripts/setup.py creates random LOCAL development values.
APP_ENV=production
PRODUCT_NAME=KernelHub SecOps Cloud
BRAND_MARK=K
BRAND_ACCENT="#47e6bd"
PUBLIC_URL=https://soc.example.com
DOMAIN=soc.example.com
ACME_EMAIL=operations@example.com
APP_IMAGE=registry.example.com/kernelhub/secops-api
WEB_IMAGE=registry.example.com/kernelhub/secops-web
RELEASE_TAG=replace-with-tested-git-commit
DATABASE_URL=postgresql://secops_app:REPLACE@private-postgres/secops?sslmode=verify-full&sslrootcert=/run/certs/postgres.pem
MIGRATION_DATABASE_URL=postgresql://secops_migration:REPLACE@private-postgres/secops?sslmode=verify-full&sslrootcert=/run/certs/postgres.pem
BROKER_URL=rediss://:REPLACE@private-redis:6379/0?ssl_cert_reqs=required
OIDC_ISSUER=https://identity.example.com/realms/kernelhub
OIDC_INTERNAL_BASE=https://identity.example.com/realms/kernelhub
OIDC_CLIENT_ID=secops-web
OIDC_CLIENT_SECRET=REPLACE
BOOTSTRAP_SUBJECT=replace-with-one-verified-provider-subject
OPENSEARCH_URL=https://private-search.example.com:9200
OPENSEARCH_USER=secops_runtime
OPENSEARCH_PASSWORD=REPLACE
S3_BUCKET=kernelhub-secops-events
S3_ENDPOINT=https://s3.example.com
AWS_DEFAULT_REGION=REPLACE
AWS_ACCESS_KEY_ID=REPLACE
AWS_SECRET_ACCESS_KEY=REPLACE
# Prefer an instance/workload identity instead of long-lived AWS keys in cloud.
# Mount CA bundles at the paths configured above; use public trusted certificates otherwise.
