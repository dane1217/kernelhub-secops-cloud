{
  admin off
  auto_https off
}
:8080 {
  request_body {
    max_size 1MB
  }
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
    Cache-Control no-store
    -Server
  }
  handle /idp/* {
    reverse_proxy keycloak:8080
  }
  handle /api/* {
    reverse_proxy api:8000
  }
  handle /auth/* {
    reverse_proxy api:8000
  }
  handle /internal/* {
    respond 404
  }
  handle {
    reverse_proxy web:3000
  }
}
